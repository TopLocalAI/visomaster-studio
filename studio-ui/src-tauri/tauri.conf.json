{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VisoMaster Studio",
  "version": "0.3.0",
  "identifier": "com.visomaster.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VisoMaster Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 660,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0f1112"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Photography",
    "copyright": "GPL-3.0. Based on VisoMaster and VisoMaster Fusion.",
    "macOS": { "minimumSystemVersion": "14.0" }
  }
}
